# Copiar como .env y ajustar. Todas son opcionales: sin .env se usan los valores de abajo.
# La sección "opciones:" de cada YAML de sitio pisa estos valores para ese sitio.

# Identificación del bot. Conviene poner un contacto real del cliente o del proyecto.
SCRAPER_USER_AGENT=MarkScraper/1.0 (+https://github.com/markbackend)

# Pausa mínima entre pedidos al mismo sitio (segundos). Si robots.txt pide Crawl-delay mayor, se usa ese.
SCRAPER_DEMORA_SEGUNDOS=1.0

# Reintentos ante errores de red, 429 y 5xx. La espera arranca en SCRAPER_ESPERA_REINTENTO y se duplica.
SCRAPER_REINTENTOS=3
SCRAPER_ESPERA_REINTENTO=2.0
SCRAPER_TIMEOUT_SEGUNDOS=20

# Respetar robots.txt (1/0). Desactivarlo SOLO con permiso escrito del dueño del sitio.
SCRAPER_RESPETAR_ROBOTS=1

# Caché local de páginas descargadas (horas; 0 = sin caché).
SCRAPER_CACHE_DIR=.cache
SCRAPER_CACHE_HORAS=24

# Carpeta donde se guardan los CSV/Excel/Word/PDF/JSON.
SCRAPER_SALIDA_DIR=salidas

# Tope de páginas de listado por corrida (el YAML puede fijar otro con paginacion.max_paginas).
SCRAPER_MAX_PAGINAS=50

# CSV: separador de columnas y separador decimal (";" y "," es lo que espera Excel en español).
SCRAPER_CSV_SEPARADOR=;
SCRAPER_CSV_DECIMAL=,

# DEBUG, INFO, WARNING o ERROR
SCRAPER_LOG_NIVEL=INFO
